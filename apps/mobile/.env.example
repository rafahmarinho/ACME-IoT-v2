# Same Supabase project for web, Android and iOS.
# Local: run `pnpm db:start` at the repo root and copy the values it prints.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (sb_publishable_...) or legacy anon key. Safe to ship in the app.
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxx
# ACME IoT API (Vercel). Local dev server: http://localhost:3001
# On a physical phone use your computer's LAN IP, e.g. http://192.168.0.10:3001
EXPO_PUBLIC_API_URL=http://localhost:3001
