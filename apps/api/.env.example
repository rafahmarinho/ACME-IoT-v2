# Supabase project (same project used by web and mobile)
SUPABASE_URL=http://127.0.0.1:54321
# Server-side secret key (sb_secret_... or legacy service_role JWT). Never expose to the app.
SUPABASE_SECRET_KEY=sb_secret_xxx
# Comma-separated list of allowed browser origins (use * for any)
CORS_ORIGINS=http://localhost:8081,https://acme-iot-web.vercel.app
# Local dev server port
PORT=3001
